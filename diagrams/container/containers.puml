@startuml
title Warmhouse Container Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(user, "User", "A user of Warmhouse application")
System(WarmhouseApp, "Warmhouse application", "System managing Smart home sensors")

Container_Boundary(WarmhouseApp, "Warmhouse application") {
  Container(WebApp, "Web Application", "JavaScript, React", "Handles user interactions")
'  services
  Container(UserService, "User Management Service", "Go", "Manages users")
  Container(SensorService, "Sensor Management Service", "Go", "Manages sensors")
  Container(TelemetryService, "Telemetry Monitoring Service", "Go", "Monitors and stores telemetry")
'  databases
  ContainerDb(UserDatabase, "User Database", "PostgreSQL", "Stores user data")
  ContainerDb(SensorDatabase, "Sensor Database", "PostgreSQL", "Stores sensor data")
  ContainerDb(TelemetryDatabase, "Telemetry Database", "PostgreSQL", "Stores telemetry data")
'  topics
  ContainerQueue(SensorControlTopic, "Sensor Control Topic", "MQTT")
  ContainerQueue(SensorStateTopic, "Sensor State Topic", "MQTT")
  ContainerQueue(SensorTelemetryTopic, "Sensor Telemetry Topic", "MQTT")
  ContainerQueue(ServiceStateTopic, "Service State Topic", "MQTT")
  ContainerQueue(ServiceTelemetryTopic, "Service Telemetry Topic", "MQTT")
}

System_Ext(sensors, "Smart home sensors", "Contains different sensors connected to Internet")

Rel(user, WebApp, "Uses the system")
Rel(user, sensors, "Installs sensors")

Rel(WebApp, UserService, "Manages users", "REST")
Rel(WebApp, SensorService, "Manages sensors", "REST")
Rel(SensorService, UserService, "Verifies users", "REST")
Rel(SensorService, TelemetryService, "Requests telemetry data", "REST")
Rel(WebApp, ServiceStateTopic, "Subscribes to")
Rel(WebApp, ServiceTelemetryTopic, "Subscribes to")

Rel(SensorService, ServiceStateTopic, "Publishes to")
Rel(TelemetryService, ServiceTelemetryTopic, "Publishes to")

Rel(UserService, UserDatabase, "Reads/writes user data")
Rel(SensorService, SensorDatabase, "Reads/writes sensor data")
Rel(TelemetryService, TelemetryDatabase, "Reads/writes telemetry data")

Rel(SensorService, SensorControlTopic, "Publishes to")
Rel(SensorService, SensorStateTopic, "Subscribes to")
Rel(TelemetryService, SensorTelemetryTopic, "Subscribes to")

Rel(sensors, SensorControlTopic, "Subscribes to")
Rel(sensors, SensorStateTopic, "Publishes to")
Rel(sensors, SensorTelemetryTopic, "Publishes to")
@enduml
